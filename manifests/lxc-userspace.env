# Phase 2 source manifest for DSM userspace experiments.
# Keep versions pinned. Keep downloaded sources outside git.

LXC_VERSION=6.0.6
LXC_URL=https://linuxcontainers.org/downloads/lxc/lxc-6.0.6.tar.gz
LXC_ASC_URL=https://linuxcontainers.org/downloads/lxc/lxc-6.0.6.tar.gz.asc
LXC_SHA256=TODO

LXCFS_VERSION=6.0.6
LXCFS_URL=https://linuxcontainers.org/downloads/lxcfs/lxcfs-6.0.6.tar.gz
LXCFS_ASC_URL=https://linuxcontainers.org/downloads/lxcfs/lxcfs-6.0.6.tar.gz.asc
LXCFS_SHA256=TODO

# LXC 7.0 is intentionally not the default for DSM 7.3 experiments yet.
# LXCFS 7.0 removed Cgroup v1 support; the current DS224+/Virtual DSM reports
# expose classic cgroup controllers, so 6.0.x is the conservative baseline.
