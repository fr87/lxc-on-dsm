#!/bin/sh
# Template for DSM package start/stop/status integration.
# This file is not installed or executed by the project yet.
set -eu

PACKAGE=%%PACKAGE_NAME%%
TARGET="/var/packages/${PACKAGE}/target"
PROFILE="/var/packages/${PACKAGE}/etc/lab-macvlan.env"

export PATH="${TARGET}/bin:${TARGET}/sbin:/opt/bin:/opt/sbin:${PATH}"
export LD_LIBRARY_PATH="${TARGET}/lib${LD_LIBRARY_PATH:+:${LD_LIBRARY_PATH}}"

case "$1" in
    start)
        exec sh "${TARGET}/scripts/start-macvlan-profile.sh" --profile "$PROFILE"
        ;;
    stop)
        exec sh "${TARGET}/scripts/stop-macvlan-profile.sh" --profile "$PROFILE"
        ;;
    status)
        exec sh "${TARGET}/scripts/doctor-macvlan-profile.sh" --profile "$PROFILE"
        ;;
    *)
        printf 'Usage: %s {start|stop|status}\n' "$0" >&2
        exit 2
        ;;
esac
