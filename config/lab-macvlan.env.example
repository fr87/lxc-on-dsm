# Example local profile for a Virtual DSM macvlan lab container.
# Copy or generate this as config/lab-macvlan.env on the DSM lab system.

LXC_LAB_PREFIX=/volume1/@lxc/lab/opt
LXC_LAB_STATE_DIR=/volume1/@lxc/lab/containers
LXC_LAB_CONTAINER=alpine-macvlanlab
LXC_LAB_PARENT_IF=eth0
LXC_LAB_SHIM_IF=lxcshim0

# Optional but required for DSM host -> macvlan container access via shim.
# Must be a free LAN IP/CIDR and must not equal the container IP.
LXC_LAB_HOST_SHIM_CIDR=
